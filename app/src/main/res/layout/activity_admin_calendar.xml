<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Admin Calendar"
        android:textSize="28sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <CalendarView
        android:id="@+id/calendarViewAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/textViewSelectedDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selected Date:"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/editTextAssignUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Username" />

    <EditText
        android:id="@+id/editTextShiftStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Start Time" />

    <EditText
        android:id="@+id/editTextShiftEnd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="End Time" />

    <Button
        android:id="@+id/buttonAssignShift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Assign Shift" />

    <TextView
        android:id="@+id/textViewShiftCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upcoming shifts on this day: 0"
        android:layout_marginTop="8dp" />

    <!-- RecyclerView now flexible -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewScheduledShifts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/buttonBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back" />

</LinearLayout>