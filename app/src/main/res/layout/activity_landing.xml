<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/textViewUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome"
            android:textSize="24sp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/buttonShift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Shift" />

        <Button
            android:id="@+id/buttonBreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Break" />

        <Button
            android:id="@+id/buttonPastShifts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Past Shifts" />

        <Button
            android:id="@+id/buttonSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings" />

        <TextView
            android:id="@+id/textViewTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shift Timer: 00:00:00"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/textViewBreakTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Break Timer: 00:00:00"
            android:textSize="22sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonOngoingShifts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ongoing Shifts"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/buttonCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calendar"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/buttonAdminOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Only"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout" />

    </LinearLayout>

</ScrollView>